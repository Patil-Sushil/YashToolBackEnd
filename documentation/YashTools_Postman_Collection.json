		{
			"name": "3. Companies",
			"item": [
				{
					"name": "Get All Companies",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.length >= 2) {",
									"    // Automatically save company IDs for testing YT and SW",
									"    jsonData.data.forEach(function(company) {",
									"        if (company.code === 'YT') {",
									"            pm.collectionVariables.set(\"companyIdYT\", company.id);",
									"        } else if (company.code === 'SW') {",
									"            pm.collectionVariables.set(\"companyIdSW\", company.id);",
									"        }",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
