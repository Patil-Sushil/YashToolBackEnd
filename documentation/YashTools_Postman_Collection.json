			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.data.token);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    pm.collectionVariables.set(\"companyCode\", jsonData.data.companyCode);",
									"    console.log(\"Saved accessToken and refreshToken to collection variables.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@yashtools.com\",\n    \"password\": \"Admin@123\"\n}"
						},
